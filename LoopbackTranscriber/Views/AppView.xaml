<UserControl x:Class="LoopbackTranscriber.Views.AppView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:LoopbackTranscriber.Converters"
             xmlns:local="clr-namespace:LoopbackTranscriber"
             xmlns:services="clr-namespace:LoopbackTranscriber.Services"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="{Binding Targets.SelectedTarget.DisplayName}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Recording.StatusText}" Opacity="0.75" Margin="0,6,0,0"
                           TextWrapping="Wrap" />

                <StackPanel Visibility="{Binding Recording.IsTranscribingActive, Converter={StaticResource BoolToVis}}"
                            Margin="0,10,0,0">
                    <ProgressBar Height="6" Width="260" HorizontalAlignment="Left"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding Recording.TranscriptionProgressPercent, Mode=OneWay}" />
                </StackPanel>

                <ItemsControl Margin="0,10,0,0" Focusable="False"
                              ItemsSource="{Binding Recording.FailedRecordings}"
                              Visibility="{Binding Recording.HasFailedRecording, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,4" Padding="10,2,4,2" CornerRadius="6"
                                    HorizontalAlignment="Left" MinWidth="380" MaxWidth="560"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ui:SymbolIcon Grid.Column="0" Symbol="Warning20" FontSize="14" Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />

                                    <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ReasonText}"
                                               ToolTipService.IsEnabled="{Binding HasReason}">
                                        <Run FontWeight="SemiBold"
                                             Text="{Binding Path=[FailedRecordingTitle], Source={x:Static services:Strings.Instance}, Mode=OneWay}" />
                                        <Run Text=" · " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Run Text="{Binding DetailText, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </TextBlock>

                                    <ui:Button Grid.Column="2" Appearance="Transparent" Padding="5" Margin="8,0,0,0"
                                               ToolTip="{Binding Path=[FailedRecordingRetry], Source={x:Static services:Strings.Instance}}"
                                               CommandParameter="{Binding FailedRecording}"
                                               Command="{Binding DataContext.Recording.RetryFailedRecordingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <ui:SymbolIcon Symbol="ArrowClockwise20" FontSize="14" />
                                    </ui:Button>
                                    <ui:Button Grid.Column="3" Appearance="Transparent" Padding="5"
                                               ToolTip="{Binding Path=[FailedRecordingDiscard], Source={x:Static services:Strings.Instance}}"
                                               CommandParameter="{Binding FailedRecording}"
                                               Command="{Binding DataContext.Recording.DiscardFailedRecordingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <ui:SymbolIcon Symbol="Delete20" FontSize="14" />
                                    </ui:Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,0" VerticalAlignment="Center">
                <ui:Button Content="{Binding Recording.RecordButtonText}"
                           Command="{Binding Recording.ToggleRecordingCommand}"
                           ToolTip="{Binding Recording.RecordDisabledReason}"
                           ToolTipService.ShowOnDisabled="True"
                           Appearance="Primary" FontWeight="SemiBold"
                           Width="190" Height="36">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Foreground" Value="Black" />
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#8C8C8C" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
                <ui:Button Content="{Binding Path=[LiveTranslationButton], Source={x:Static services:Strings.Instance}}"
                           Appearance="Secondary" FontWeight="SemiBold" Margin="12,0,0,0"
                           Width="190" Height="36"
                           Command="{Binding ToggleLiveTranslationCommand}" />
                <TextBlock Text="{Binding Recording.ElapsedText}" FontSize="16" VerticalAlignment="Center"
                           Margin="16,0,0,0"
                           Visibility="{Binding Recording.IsRecording, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <Grid Grid.Row="3" Margin="0,18,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="420" MinWidth="280" MaxWidth="640" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <ui:Button Padding="6" Appearance="Transparent" Margin="0,0,6,0"
                                   Command="{Binding Viewer.ClearViewedTranscriptCommand}"
                                   ToolTip="{Binding Path=[ClearTranscriptViewerTooltip], Source={x:Static services:Strings.Instance}}">
                            <ui:SymbolIcon Symbol="Eraser20" FontSize="14" />
                        </ui:Button>
                        <ui:Button Content="{Binding Path=[TabTranscript], Source={x:Static services:Strings.Instance}}"
                                   Appearance="Transparent" Padding="10,5" Margin="0,0,6,0"
                                   Command="{Binding Viewer.ShowTranscriptTabCommand}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Opacity" Value="0.55" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Viewer.IsShowingSummaryTab}" Value="False">
                                            <Setter Property="Opacity" Value="1" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <ui:Button Content="{Binding Path=[TabSummary], Source={x:Static services:Strings.Instance}}"
                                   Appearance="Transparent" Padding="10,5"
                                   Command="{Binding Viewer.ShowSummaryTabCommand}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Opacity" Value="0.55" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Viewer.IsShowingSummaryTab}" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </StackPanel>
                    <Border Grid.Column="1" Margin="12,0,0,0" Padding="2" Background="Transparent" VerticalAlignment="Center" Cursor="Hand"
                            ToolTipService.InitialShowDelay="100"
                            Visibility="{Binding Viewer.ShowSummaryModelWarning, Converter={StaticResource BoolToVis}}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ShowConfigCommand}" />
                        </Border.InputBindings>
                        <Border.ToolTip>
                            <TextBlock Text="{Binding Path=[SummaryModelMissingHint], Source={x:Static services:Strings.Instance}}"
                                       TextWrapping="Wrap" TextAlignment="Left" MaxWidth="260" />
                        </Border.ToolTip>
                        <ui:SymbolIcon Symbol="Warning24" FontSize="22" Foreground="#FFC02E" />
                    </Border>
                    <ui:Button Grid.Column="2" Appearance="Secondary" Margin="12,0,0,0" Padding="10,5" VerticalAlignment="Center"
                               Visibility="{Binding Viewer.ShowViewedSummaryButton, Converter={StaticResource BoolToVis}}"
                               IsEnabled="{Binding Viewer.CanGenerateViewedSummary}"
                               Command="{Binding Viewer.RegenerateViewedSummaryCommand}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding Viewer.ShowViewedIdleGenerate, Converter={StaticResource BoolToVis}}">
                                <ui:SymbolIcon Symbol="Sparkle20" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Path=[GenerateSummaryButton], Source={x:Static services:Strings.Instance}}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding Viewer.IsViewedSummaryGenerating, Converter={StaticResource BoolToVis}}">
                                <ui:SymbolIcon Symbol="ArrowSync20" FontSize="14" Margin="0,0,6,0" Style="{StaticResource SpinningIconStyle}">
                                    <ui:SymbolIcon.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </ui:SymbolIcon.RenderTransform>
                                </ui:SymbolIcon>
                                <TextBlock Text="{Binding Path=[GenerateSummaryButtonBusy], Source={x:Static services:Strings.Instance}}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Viewer.ViewedSummaryProgressPercent, StringFormat={}{0:0}%}" VerticalAlignment="Center"
                                           Margin="4,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding Viewer.ShowViewedRegenerate, Converter={StaticResource BoolToVis}}">
                                <ui:SymbolIcon Symbol="CheckmarkCircle20" FontSize="14" Margin="0,0,6,0" Opacity="0.7" />
                                <TextBlock Text="{Binding Path=[RegenerateSummaryButton], Source={x:Static services:Strings.Instance}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </ui:Button>
                </Grid>

                <Grid Grid.Row="0" Grid.Column="2" Margin="6,0,0,8" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Path=[HistoryOfAppTitle], Source={x:Static services:Strings.Instance}}"
                               FontWeight="SemiBold" Opacity="0.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <ui:Button Grid.Column="1" Margin="0,0,6,0" Padding="12,7" FontSize="13" VerticalAlignment="Center"
                               Content="{Binding Path=[Delete], Source={x:Static services:Strings.Instance}}"
                               Command="{Binding History.DeleteSelectedAppTranscriptsCommand}"
                               IsEnabled="{Binding History.CanDeleteSelectedApp}"
                               ToolTip="{Binding History.DeleteSelectedAppDisabledReason}"
                               ToolTipService.ShowOnDisabled="True"
                               Visibility="{Binding History.HasSelectedAppHistoryItems, Converter={StaticResource BoolToVis}}" />
                    <ui:Button x:Name="AppHistoryFilterButton" Grid.Column="2" Margin="0,0,6,0" Padding="7" VerticalAlignment="Center"
                               Command="{Binding History.AppFilter.ToggleCommand}"
                               ToolTip="{Binding Path=[FilterTooltip], Source={x:Static services:Strings.Instance}}">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding History.AppFilter.HasActiveFilter}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:SymbolIcon Symbol="Filter16" FontSize="14" />
                    </ui:Button>
                    <ui:Button Grid.Column="3" Padding="7" VerticalAlignment="Center"
                               Command="{Binding History.OpenTranscriptsFolderCommand}"
                               ToolTip="{Binding Path=[OpenFolder], Source={x:Static services:Strings.Instance}}">
                        <ui:SymbolIcon Symbol="FolderOpen20" FontSize="14" />
                    </ui:Button>

                    <Popup Grid.Column="2" PlacementTarget="{Binding ElementName=AppHistoryFilterButton}"
                           Placement="Left" HorizontalOffset="-6" IsOpen="{Binding History.AppFilter.IsOpen}"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Width="260" CornerRadius="8" Padding="16"
                                Background="{DynamicResource FlyoutBackground}"
                                BorderBrush="{DynamicResource FlyoutBorderBrush}" BorderThickness="1">
                            <Border.Resources>
                                <SolidColorBrush x:Key="CalendarViewBackground" Color="#FF2B2B2B" />
                                <SolidColorBrush x:Key="CalendarViewBorderBrush" Color="#FF3D3D3D" />
                                <SolidColorBrush x:Key="CalendarViewTodayBackground" Color="#FF6A2BD9" />
                                <SolidColorBrush x:Key="CalendarViewTodayForeground" Color="#FFFFFFFF" />
                            </Border.Resources>
                            <StackPanel>
                                <TextBlock Text="{Binding Path=[FilterFromDateLabel], Source={x:Static services:Strings.Instance}}"
                                           FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                                <DatePicker x:Name="AppHistoryFilterFromDatePicker"
                                            SelectedDate="{Binding History.AppFilter.FromDate}" Margin="0,0,0,10"
                                            DisplayDate="{x:Static sys:DateTime.Today}"
                                            Background="{DynamicResource FlyoutBackground}"
                                            BorderBrush="{DynamicResource FlyoutBorderBrush}"
                                            CalendarOpened="HistoryDatePicker_CalendarOpened" />

                                <TextBlock Text="{Binding Path=[FilterToDateLabel], Source={x:Static services:Strings.Instance}}"
                                           FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                                <DatePicker SelectedDate="{Binding History.AppFilter.ToDate}" Margin="0,0,0,10"
                                            Background="{DynamicResource FlyoutBackground}"
                                            BorderBrush="{DynamicResource FlyoutBorderBrush}" />

                                <TextBlock Text="{Binding Path=[FilterDurationLabel], Source={x:Static services:Strings.Instance}}"
                                           FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                                <ui:NumberBox Minimum="0" Margin="0,0,0,12"
                                              Value="{Binding History.AppFilter.MinDurationMinutes, UpdateSourceTrigger=PropertyChanged}"
                                              PlaceholderText="{Binding Path=[FilterMinPlaceholder], Source={x:Static services:Strings.Instance}}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:Button Grid.Column="0" Appearance="Primary" FontWeight="SemiBold"
                                               Content="{Binding Path=[FilterApplyButton], Source={x:Static services:Strings.Instance}}"
                                               Command="{Binding History.AppFilter.ApplyCommand}"
                                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                    <ui:Button Grid.Column="2"
                                               Content="{Binding Path=[FilterClearButton], Source={x:Static services:Strings.Instance}}"
                                               Command="{Binding History.AppFilter.ClearCommand}"
                                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                               IsEnabled="{Binding History.AppFilter.HasActiveFilter}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <Border Grid.Row="1" Grid.Column="0" MinHeight="230" CornerRadius="10" Padding="14"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Viewer.TranscriptMessages}"
                                      Style="{StaticResource VirtualizedBubbleListStyle}"
                                      Visibility="{Binding Viewer.IsShowingSummaryTab, Converter={StaticResource InverseBoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4"
                                                    MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource WidthFraction}, ConverterParameter=0.55}"
                                                    HorizontalAlignment="{Binding IsSelf, Converter={StaticResource BoolToChatAlignment}}">
                                            <TextBlock Text="{Binding DisplaySpeaker}" FontSize="13" FontWeight="SemiBold"
                                                       Opacity="0.5" Margin="4,0,4,6" />
                                            <Border CornerRadius="14" Padding="12,8"
                                                    Style="{StaticResource ChatBubbleBorderStyle}">
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" Foreground="White" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding Viewer.IsShowingSummaryTab, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Text="{Binding Viewer.ViewedSummaryTitle}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Viewer.ViewedSummarySections}"
                                              ItemTemplate="{StaticResource SummarySectionTemplate}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1" Grid.Column="1" Style="{StaticResource VerticalPanelSplitterStyle}" />

                <Border Grid.Row="1" Grid.Column="2" CornerRadius="8"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ui:TextBox Grid.Row="0" Margin="0,0,0,10"
                                    Text="{Binding History.AppHistorySearch.Text, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{Binding Path=[SearchHistoryPlaceholder], Source={x:Static services:Strings.Instance}}"
                                    ClearButtonEnabled="True">
                            <ui:TextBox.Icon>
                                <ui:SymbolIcon Symbol="Search16" />
                            </ui:TextBox.Icon>
                        </ui:TextBox>
                        <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" Opacity="0.55"
                                   Text="{Binding Path=[SearchNoResults], Source={x:Static services:Strings.Instance}}"
                                   Visibility="{Binding History.ShowAppHistoryNoResults, Converter={StaticResource BoolToVis}}" />
                        <ScrollViewer Grid.Row="1" Margin="0,0,0,0" VerticalAlignment="Stretch" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding History.AppTranscriptHistory}" HorizontalContentAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="10,8" Margin="0,0,0,6"
                                            HorizontalAlignment="Stretch"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                            Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.Viewer.ViewHistoryTranscriptCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <CheckBox Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                                                      VerticalAlignment="Center" Margin="0,0,10,0"
                                                      Padding="0" MinWidth="0" MinHeight="0"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                                            <Grid Grid.Column="1" Grid.Row="0" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DisplayTitle}"
                                                           FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding TimestampText}" Margin="8,0,0,0"
                                                           Opacity="0.55" FontSize="11" VerticalAlignment="Center" />
                                            </Grid>

                                            <TextBlock Grid.Column="1" Grid.Row="1" Margin="0,4,0,0" Text="{Binding Preview}"
                                                       Opacity="0.7" FontSize="12" VerticalAlignment="Center"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                </Border>
            </Grid>
        </Grid>
</UserControl>

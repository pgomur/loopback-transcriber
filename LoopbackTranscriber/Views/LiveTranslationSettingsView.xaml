<UserControl x:Class="LoopbackTranscriber.Views.LiveTranslationSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:services="clr-namespace:LoopbackTranscriber.Services"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="LiveSettingsSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,0,0,10" />
        </Style>
        <Style x:Key="LiveSettingsSectionCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="LiveSettingsFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style x:Key="LiveSettingsHintStyle" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="PreviewHeaderIconButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style x:Key="LiveSettingsDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,14,0,14" />
            <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,4,16">
            <TextBlock Text="{Binding Path=[LiveTranslationButton], Source={x:Static services:Strings.Instance}}"
                       FontSize="20" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Style="{StaticResource LiveSettingsHintStyle}" Margin="0,0,0,16"
                       Text="{Binding Path=[ConfigLiveHint], Source={x:Static services:Strings.Instance}}" />

            <TextBlock Style="{StaticResource LiveSettingsSectionHeaderStyle}"
                       Text="{Binding Path=[LiveSettingsPreviewSection], Source={x:Static services:Strings.Instance}}" />

            <Border Height="340" CornerRadius="10" ClipToBounds="True">
                <Border.Background>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute"
                                  Viewbox="0,0,24,24" ViewboxUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#FF7C7C7C">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,24,24" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#FF8E8E8E">
                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <RectangleGeometry Rect="0,0,12,12" />
                                            <RectangleGeometry Rect="12,12,12,12" />
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.Background>

                <Border Margin="40,28" CornerRadius="10" BorderThickness="1"
                        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        BorderBrush="{DynamicResource FlyoutBorderBrush}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.45" Color="Black" />
                    </Border.Effect>

                    <Grid>
                        <Border CornerRadius="9" Background="{DynamicResource FlyoutBackground}"
                                Opacity="{Binding LiveWindowOpacity}" />

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Padding="14,8,8,8" BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Path=[LiveTranslationButton], Source={x:Static services:Strings.Instance}}"
                                                   FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Text="· Teams" Opacity="0.75" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,6,0"
                                                Background="Transparent"
                                                ToolTip="{Binding Path=[LiveWindowTargetLanguageTooltip], Source={x:Static services:Strings.Instance}}">
                                        <TextBlock Text="{Binding Path=[LiveWindowTranslateTo], Source={x:Static services:Strings.Instance}}"
                                                   FontSize="12" Opacity="0.75" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <ComboBox Width="100" FontSize="12" VerticalAlignment="Center" Focusable="False" IsTabStop="False" IsHitTestVisible="False"
                                                  ItemsSource="{Binding AvailableLanguages}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="Code"
                                                  SelectedValue="{Binding LiveTranslationLanguage, Mode=OneWay}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Style="{StaticResource PreviewHeaderIconButtonStyle}"
                                                   ToolTip="{Binding Path=[LiveWindowOpenMainTooltip], Source={x:Static services:Strings.Instance}}">
                                            <ui:SymbolIcon Symbol="WindowNew24" FontSize="14" />
                                        </ui:Button>
                                        <ui:Button Style="{StaticResource PreviewHeaderIconButtonStyle}"
                                                   ToolTip="{Binding Path=[LiveWindowOpacityTooltip], Source={x:Static services:Strings.Instance}}">
                                            <ui:SymbolIcon Symbol="Drop24" FontSize="14" />
                                        </ui:Button>
                                        <ui:Button Style="{StaticResource PreviewHeaderIconButtonStyle}"
                                                   ToolTip="{Binding Path=[LiveWindowUnpinTooltip], Source={x:Static services:Strings.Instance}}">
                                            <ui:SymbolIcon Symbol="Pin24" FontSize="14" />
                                        </ui:Button>
                                        <ui:Button Style="{StaticResource PreviewHeaderIconButtonStyle}"
                                                   ToolTip="{Binding Path=[LiveWindowCloseTooltip], Source={x:Static services:Strings.Instance}}">
                                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="18,12,18,12">
                                    <Border Margin="0,0,0,12" Padding="12,0,0,0" BorderThickness="3,0,0,0" BorderBrush="Transparent" Opacity="0.75">
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap" FontSize="{Binding LiveTextSize}"
                                                   Text="{Binding PreviewLineMain}" />
                                        <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,2,0,0"
                                                   FontSize="{Binding PreviewOriginalTextSize}"
                                                   Text="{Binding PreviewLineOriginal}"
                                                   Visibility="{Binding PreviewShowOriginal, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    </Border>
                                    <Border Padding="12,0,0,0" BorderThickness="3,0,0,0" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap" FontSize="{Binding LiveTextSize}"
                                                   Text="{Binding PreviewDraftMain}" />
                                        <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,2,0,0"
                                                   FontSize="{Binding PreviewOriginalTextSize}"
                                                   Text="{Binding PreviewDraftOriginal}"
                                                   Visibility="{Binding PreviewShowOriginal, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Row="2" Padding="14,10,24,10" BorderThickness="0,1,0,0" IsHitTestVisible="False"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="#E53935" VerticalAlignment="Center" />
                                        <TextBlock Opacity="0.85" Margin="8,0,12,0" VerticalAlignment="Center">
                                            <Run Text="{Binding Path=[LiveWindowRecording], Source={x:Static services:Strings.Instance}, Mode=OneWay}" /><Run Text=" · 00:12" />
                                        </TextBlock>
                                    </StackPanel>

                                    <ui:Button Grid.Row="0" Grid.Column="1" Appearance="Primary" FontWeight="SemiBold" Height="34" Padding="18,0"
                                               Focusable="False" Foreground="Black"
                                               Content="{Binding Path=[RecordStop], Source={x:Static services:Strings.Instance}, Mode=OneWay}" />

                                </Grid>
                            </Border>

                            <Border Grid.Row="3" Padding="14,6,24,6" BorderThickness="0,1,0,0" CornerRadius="0,0,9,9"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    Visibility="{Binding LiveShowMetrics, Converter={StaticResource BoolToVis}}">
                                <WrapPanel Orientation="Horizontal">
                                    <TextBlock FontSize="11" Opacity="0.7" Text="{Binding PreviewSignalText}" />
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasPreviewChunkText, Converter={StaticResource BoolToVis}}">
                                        <Border Width="1" Height="10" Margin="10,0" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                        <TextBlock FontSize="11" Opacity="0.7" Text="{Binding PreviewChunkText}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasPreviewTranslationText, Converter={StaticResource BoolToVis}}">
                                        <Border Width="1" Height="10" Margin="10,0" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                        <TextBlock FontSize="11" Opacity="0.7" Text="{Binding PreviewTranslationText}" />
                                    </StackPanel>
                                </WrapPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-16,0">
            <Grid Margin="0,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LiveSettingsSectionHeaderStyle}"
                           Text="{Binding Path=[LiveSettingsTranslationSection], Source={x:Static services:Strings.Instance}}" />
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource LiveSettingsSectionCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource LiveSettingsFieldLabelStyle}"
                                   Text="{Binding Path=[ConfigLiveLanguageLabel], Source={x:Static services:Strings.Instance}}" />
                        <ComboBox HorizontalAlignment="Left" Width="200"
                                  ItemsSource="{Binding AvailableLanguages}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding LiveTranslationLanguage, Mode=TwoWay}" />

                        <Border Style="{StaticResource LiveSettingsDividerStyle}" />

                        <ui:ToggleSwitch Content="{Binding Path=[ConfigLiveShowOriginalLabel], Source={x:Static services:Strings.Instance}}"
                                         IsChecked="{Binding LiveShowOriginal, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource LiveSettingsSectionHeaderStyle}"
                           Text="{Binding Path=[LiveSettingsWindowSection], Source={x:Static services:Strings.Instance}}" />
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource LiveSettingsSectionCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LiveSettingsFieldLabelStyle}"
                                       Text="{Binding Path=[ConfigLiveTextSizeLabel], Source={x:Static services:Strings.Instance}}" />
                            <TextBlock Grid.Column="1" Opacity="0.8" Text="{Binding LiveTextSize, StringFormat={}{0:0} pt}" />
                        </Grid>
                        <Slider Minimum="14" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True"
                                SmallChange="1" LargeChange="2" IsMoveToPointEnabled="True"
                                Value="{Binding LiveTextSize, Mode=TwoWay, Delay=250}" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LiveSettingsFieldLabelStyle}"
                                       Text="{Binding Path=[LiveWindowOpacityTooltip], Source={x:Static services:Strings.Instance}}" />
                            <TextBlock Grid.Column="1" Opacity="0.8" Text="{Binding LiveWindowOpacity, StringFormat={}{0:P0}}" />
                        </Grid>
                        <Slider Minimum="0.3" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                IsMoveToPointEnabled="True"
                                Value="{Binding LiveWindowOpacity, Mode=TwoWay, Delay=250}" />

                        <Border Style="{StaticResource LiveSettingsDividerStyle}" />

                        <ui:ToggleSwitch Content="{Binding Path=[ConfigLiveShowMetricsLabel], Source={x:Static services:Strings.Instance}}"
                                         IsChecked="{Binding LiveShowMetrics, Mode=TwoWay}" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

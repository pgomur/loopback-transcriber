<UserControl x:Class="LoopbackTranscriber.Views.ApplicationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:services="clr-namespace:LoopbackTranscriber.Services"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="AppsSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="AppsSectionCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,24" />
        </Style>
        <Style x:Key="AppsCountPillStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#22FFFFFF" />
        </Style>
        <Style x:Key="AppsRowStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="AppsIconTileStyle" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#1FFFFFFF" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-16,0">
            <StackPanel Margin="0,0,20,0">
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Path=[AppsTitle], Source={x:Static services:Strings.Instance}}"
                                   FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Path=[AppsSubtitle], Source={x:Static services:Strings.Instance}}"
                                   Opacity="0.75" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" VerticalAlignment="Top" Margin="16,0,0,0"
                               Command="{Binding RefreshCommand}"
                               ToolTip="{Binding Path=[AppsRefresh], Source={x:Static services:Strings.Instance}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowSync20" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Path=[AppsRefresh], Source={x:Static services:Strings.Instance}}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="2,0,0,10">
                    <TextBlock Style="{StaticResource AppsSectionHeaderStyle}"
                               Text="{Binding Path=[AppsAddedHeader], Source={x:Static services:Strings.Instance}}" />
                    <Border Style="{StaticResource AppsCountPillStyle}">
                        <TextBlock Text="{Binding AddedApps.Count}" FontSize="12" Opacity="0.85" />
                    </Border>
                </StackPanel>

                <Border Style="{StaticResource AppsSectionCardStyle}">
                    <StackPanel>
                        <StackPanel HorizontalAlignment="Center" Margin="0,12"
                                    Visibility="{Binding HasNoAddedApps, Converter={StaticResource BoolToVis}}">
                            <ui:SymbolIcon Symbol="AppGeneric24" FontSize="28" Opacity="0.4" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Path=[AppsNoneAdded], Source={x:Static services:Strings.Instance}}"
                                       Opacity="0.6" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding AddedApps}" Margin="0,0,0,-8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource AppsRowStyle}">
                                        <Grid MinHeight="32">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ProcessName}" Opacity="0.6" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <ui:Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Padding="14,6"
                                                       Content="{Binding Path=[AppsRemove], Source={x:Static services:Strings.Instance}}"
                                                       IsEnabled="{Binding CanRemove}"
                                                       Visibility="{Binding ShowRemoveButton, Converter={StaticResource BoolToVis}}"
                                                       ToolTipService.ShowOnDisabled="True"
                                                       Command="{Binding DataContext.RemoveAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}">
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanRemove}" Value="False">
                                                                <Setter Property="ToolTip" Value="{Binding Path=[AppsRemoveBlockedTooltip], Source={x:Static services:Strings.Instance}}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="2,0,0,10">
                    <TextBlock Style="{StaticResource AppsSectionHeaderStyle}"
                               Text="{Binding Path=[AppsDetectedHeader], Source={x:Static services:Strings.Instance}}" />
                    <Border Style="{StaticResource AppsCountPillStyle}">
                        <TextBlock Text="{Binding DiscoveredApps.Count}" FontSize="12" Opacity="0.85" />
                    </Border>
                </StackPanel>

                <Border Style="{StaticResource AppsSectionCardStyle}">
                    <StackPanel>
                        <StackPanel HorizontalAlignment="Center" Margin="0,12"
                                    Visibility="{Binding HasNoDiscoveredApps, Converter={StaticResource BoolToVis}}">
                            <ui:SymbolIcon Symbol="AppGeneric24" FontSize="28" Opacity="0.4" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Path=[AppsNoneDetected], Source={x:Static services:Strings.Instance}}"
                                       Opacity="0.6" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding DiscoveredApps}" Margin="0,0,0,-8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource AppsRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ProcessName}" Opacity="0.6" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <ui:Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Padding="14,6"
                                                       Content="{Binding Path=[AppsAdd], Source={x:Static services:Strings.Instance}}"
                                                       Command="{Binding DataContext.AddAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

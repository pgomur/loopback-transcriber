<UserControl x:Class="LoopbackTranscriber.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:LoopbackTranscriber.Converters"
             xmlns:services="clr-namespace:LoopbackTranscriber.Services"
             mc:Ignorable="d">
    <UserControl.Resources>
        <conv:InverseBooleanConverter x:Key="InverseDownloadConverter" />
        <conv:InverseBooleanConverter x:Key="InverseBoolConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToStatusBrushConverter x:Key="BoolToStatusBrush" />
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-16,0">
            <StackPanel Margin="0,0,20,0">
                <TextBlock Text="{Binding Path=[ConfigTitle], Source={x:Static services:Strings.Instance}}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20" />

                <TextBlock Text="{Binding Path=[ConfigGeneralSection], Source={x:Static services:Strings.Instance}}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="{Binding Path=[ConfigAppLanguageLabel], Source={x:Static services:Strings.Instance}}" Margin="0,0,0,6" Opacity="0.8" />
                    <ComboBox Width="200" HorizontalAlignment="Left"
                              ItemsSource="{Binding AvailableUiLanguages}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Code"
                              SelectedValue="{Binding UiLanguage, Mode=TwoWay}" />
                </StackPanel>

                <Border Height="1" Margin="0,0,0,20" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                <TextBlock Text="{Binding Path=[ConfigTranscriptionSection], Source={x:Static services:Strings.Instance}}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="{Binding Path=[ConfigModelLabel], Source={x:Static services:Strings.Instance}}" Margin="0,0,0,6" Opacity="0.8" />

                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="150" HorizontalAlignment="Left"
                                  ItemsSource="{Binding AvailableModelSizes}"
                                  SelectedItem="{Binding ModelSize, Mode=TwoWay}" />
                        <ui:Button Content="{Binding Path=[ConfigDownloadModel], Source={x:Static services:Strings.Instance}}" Margin="10,0,0,0"
                                   Command="{Binding DownloadModelNowCommand}"
                                   IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseDownloadConverter}}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                 Fill="{Binding IsModelDownloaded, Converter={StaticResource BoolToStatusBrush}}" />
                        <TextBlock Text="{Binding ModelStatusText}" Opacity="0.8" TextWrapping="Wrap" />
                    </StackPanel>

                    <ProgressBar Margin="0,10,0,0" Height="6" Width="220" HorizontalAlignment="Left"
                                 Minimum="0" Maximum="100" Value="{Binding DownloadProgressPercent, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}"
                                 Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="{Binding DownloadStatus}" Opacity="0.75" Margin="0,6,0,0" TextWrapping="Wrap"
                               Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <StackPanel Margin="0,0,0,4">
                    <TextBlock Text="{Binding Path=[ConfigMeetingLanguageLabel], Source={x:Static services:Strings.Instance}}" Margin="0,0,0,6" Opacity="0.8" />
                    <ComboBox Width="260" HorizontalAlignment="Left"
                              ItemsSource="{Binding AvailableLanguages}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Code"
                              SelectedValue="{Binding Language, Mode=TwoWay}" />
                    <TextBlock Text="{Binding Path=[ConfigMeetingLanguageHint], Source={x:Static services:Strings.Instance}}"
                               Opacity="0.6" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <Border Height="1" Margin="0,20,0,20" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                <TextBlock Text="{Binding Path=[ConfigInstalledModelsSection], Source={x:Static services:Strings.Instance}}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />

                <TextBlock Text="{Binding Path=[ConfigNoModelsInstalled], Source={x:Static services:Strings.Instance}}"
                           Opacity="0.6" Margin="0,0,0,16"
                           Visibility="{Binding HasNoInstalledModels, Converter={StaticResource BoolToVis}}" />

                <ItemsControl ItemsSource="{Binding InstalledModels}" Margin="0,0,0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="10,8" Margin="0,0,0,6"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{Binding Path=[ConfigInUseSuffix], Source={x:Static services:Strings.Instance}}" FontSize="12" Opacity="0.6"
                                                       Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding FileSizeText}" Opacity="0.6" FontSize="12" />
                                    </StackPanel>

                                    <ui:Button Grid.Column="1" Content="{Binding Path=[ConfigUse], Source={x:Static services:Strings.Instance}}" Margin="8,0,0,0"
                                               IsEnabled="{Binding IsActive, Converter={StaticResource InverseBoolConverter}}"
                                               Command="{Binding DataContext.UseModelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}" />

                                    <ui:Button Grid.Column="2" Content="{Binding Path=[Delete], Source={x:Static services:Strings.Instance}}" Margin="8,0,0,0"
                                               Command="{Binding DataContext.DeleteModelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Height="1" Margin="0,16,0,20" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                <TextBlock Text="{Binding Path=[ConfigFoldersSection], Source={x:Static services:Strings.Instance}}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="{Binding Path=[ConfigModelsFolderLabel], Source={x:Static services:Strings.Instance}}" Margin="0,0,0,6" Opacity="0.8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding ModelsFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Grid.Column="1" Content="{Binding Path=[ConfigOpen], Source={x:Static services:Strings.Instance}}" Margin="8,0,0,0" Command="{Binding OpenModelsFolderCommand}" />
                    </Grid>
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="{Binding Path=[ConfigTranscriptsFolderLabel], Source={x:Static services:Strings.Instance}}" Margin="0,0,0,6" Opacity="0.8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding TranscriptsFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Grid.Column="1" Content="{Binding Path=[ConfigOpen], Source={x:Static services:Strings.Instance}}" Margin="8,0,0,0" Command="{Binding OpenTranscriptsFolderCommand}" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

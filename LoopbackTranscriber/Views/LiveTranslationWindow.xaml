<Window x:Class="LoopbackTranscriber.Views.LiveTranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:services="clr-namespace:LoopbackTranscriber.Services"
        Title="{Binding Path=[LiveWindowTitle], Source={x:Static services:Strings.Instance}}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="{Binding IsPinned}"
        ResizeMode="NoResize"
        Width="860" Height="520" MinWidth="400" MinHeight="260"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <Style x:Key="LiveTranslationTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{Binding DataContext.TextSize, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="LiveOriginalTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{Binding DataContext.OriginalTextSize, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="LiveCurrentBarStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="Padding" Value="12,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style x:Key="HeaderIconButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <ControlTemplate x:Key="ResizeGripTemplate" TargetType="Thumb">
            <Border Background="Transparent">
                <Path Data="M 12,4 L 4,12 M 12,8 L 8,12" Stroke="{DynamicResource TextFillColorSecondaryBrush}"
                      StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3" />
            </Border>
        </ControlTemplate>
    </Window.Resources>

    <Border Margin="14" CornerRadius="10" BorderThickness="1"
            TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            BorderBrush="{DynamicResource FlyoutBorderBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.45" Color="Black" />
        </Border.Effect>

        <Grid>
        <Border CornerRadius="9" Background="{DynamicResource FlyoutBackground}"
                Opacity="{Binding WindowOpacity}" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="14,8,8,8" Background="Transparent"
                    BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Path=[LiveTranslationButton], Source={x:Static services:Strings.Instance}}"
                                   FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AppName, StringFormat=· {0}}"
                                   Opacity="0.75" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,6,0"
                                ToolTip="{Binding Path=[LiveWindowTargetLanguageTooltip], Source={x:Static services:Strings.Instance}}">
                        <TextBlock Text="{Binding Path=[LiveWindowTranslateTo], Source={x:Static services:Strings.Instance}}"
                                   FontSize="12" Opacity="0.75" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <ComboBox Width="100" FontSize="12" VerticalAlignment="Center"
                                  ItemsSource="{Binding Languages}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding SelectedLanguageCode, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Style="{StaticResource HeaderIconButtonStyle}"
                                   Command="{Binding OpenMainWindowCommand}"
                                   ToolTip="{Binding Path=[LiveWindowOpenMainTooltip], Source={x:Static services:Strings.Instance}}">
                            <ui:SymbolIcon Symbol="WindowNew24" FontSize="14" />
                        </ui:Button>
                        <ui:Button x:Name="OpacityButton" Style="{StaticResource HeaderIconButtonStyle}"
                                   Click="OnOpacityClick"
                                   ToolTip="{Binding Path=[LiveWindowOpacityTooltip], Source={x:Static services:Strings.Instance}}">
                            <ui:SymbolIcon Symbol="Drop24" FontSize="14" />
                        </ui:Button>
                        <Popup x:Name="OpacityPopup" PlacementTarget="{Binding ElementName=OpacityButton}"
                               Placement="Custom" StaysOpen="False" AllowsTransparency="True"
                               PopupAnimation="Fade" Closed="OnOpacityPopupClosed">
                            <Border Margin="10" Padding="14,10" CornerRadius="8" BorderThickness="1"
                                    Background="{DynamicResource FlyoutBackground}"
                                    BorderBrush="{DynamicResource FlyoutBorderBrush}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.4" Color="Black" />
                                </Border.Effect>
                                <StackPanel Width="190">
                                    <TextBlock Text="{Binding Path=[LiveWindowOpacityTooltip], Source={x:Static services:Strings.Instance}}"
                                               FontSize="12" Opacity="0.75" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="0.3" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                                IsMoveToPointEnabled="True" VerticalAlignment="Center"
                                                Value="{Binding WindowOpacity, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="1" Width="42" TextAlignment="Right" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Text="{Binding WindowOpacity, StringFormat={}{0:P0}}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <ui:Button Style="{StaticResource HeaderIconButtonStyle}"
                                   Command="{Binding TogglePinCommand}"
                                   ToolTip="{Binding PinTooltip}">
                            <ui:SymbolIcon FontSize="14">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="Pin24" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPinned}" Value="False">
                                                <Setter Property="Symbol" Value="PinOff24" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </ui:Button>
                        <ui:Button Style="{StaticResource HeaderIconButtonStyle}"
                                   Click="OnCloseClick"
                                   ToolTip="{Binding Path=[LiveWindowCloseTooltip], Source={x:Static services:Strings.Instance}}">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="LinesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="OnLinesScrollChanged">
                <Grid>
                    <TextBlock Text="{Binding EmptyHintText}" Opacity="0.55" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,40"
                               Visibility="{Binding ShowEmptyHint, Converter={StaticResource BoolToVis}}" />

                    <StackPanel Margin="18,14,18,14">
                        <ItemsControl ItemsSource="{Binding Lines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,14" Opacity="{Binding Emphasis}">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource LiveCurrentBarStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource LiveTranslationTextStyle}" Text="{Binding Original}"
                                                   Opacity="{Binding MainOpacity}"
                                                   Visibility="{Binding ShowOriginalMain, Converter={StaticResource BoolToVis}}" />

                                        <TextBlock Style="{StaticResource LiveTranslationTextStyle}"
                                                   Text="{Binding TranslationDisplay}" Opacity="{Binding MainOpacity}"
                                                   Visibility="{Binding ShowTranslation, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Style="{StaticResource LiveOriginalTextStyle}" Text="{Binding Original}"
                                                   Visibility="{Binding ShowOriginalSmall, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource LiveCurrentBarStyle}" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                Visibility="{Binding ShowPending, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LiveTranslationTextStyle}" Text="{Binding DraftMainText}"
                                           Visibility="{Binding ShowDraftMain, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Style="{StaticResource LiveOriginalTextStyle}" Text="{Binding DraftOriginalText}"
                                           Visibility="{Binding ShowDraftOriginal, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="14,10,24,10"
                    BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Recording">
                                            <Setter Property="Fill" Value="#E53935" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Busy">
                                            <Setter Property="Fill" Value="#FFC02E" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Finished">
                                            <Setter Property="Fill" Value="#3ECF8E" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusLine}" Opacity="0.85" Margin="8,0,12,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <ui:Button Grid.Row="0" Grid.Column="1" Appearance="Primary" FontWeight="SemiBold" Height="34" Padding="18,0"
                               Content="{Binding ButtonText}"
                               Command="{Binding StartStopCommand}"
                               ToolTip="{Binding DisabledReason}"
                               ToolTipService.ShowOnDisabled="True">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Foreground" Value="Black" />
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground" Value="#8C8C8C" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>

                    <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Height="4" Margin="0,8,0,0"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding Progress, Mode=OneWay}"
                                 Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>

            <Border Grid.Row="3" Padding="14,6,24,6" BorderThickness="0,1,0,0" CornerRadius="0,0,9,9"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    ToolTip="{Binding MetricsText}"
                    Visibility="{Binding ShowMetrics, Converter={StaticResource BoolToVis}}">
                <WrapPanel Orientation="Horizontal">
                    <TextBlock FontSize="11" Opacity="0.7" Text="{Binding MetricsSignalText}" />
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasMetricsChunkText, Converter={StaticResource BoolToVis}}">
                        <Border Width="1" Height="10" Margin="10,0" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                        <TextBlock FontSize="11" Opacity="0.7" Text="{Binding MetricsChunkText}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasMetricsTranslationText, Converter={StaticResource BoolToVis}}">
                        <Border Width="1" Height="10" Margin="10,0" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                        <TextBlock FontSize="11" Opacity="0.7" Text="{Binding MetricsTranslationText}" />
                    </StackPanel>
                </WrapPanel>
            </Border>

            <Thumb Grid.Row="0" Grid.RowSpan="4" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Cursor="SizeNWSE" Template="{StaticResource ResizeGripTemplate}"
                   DragDelta="OnResizeGripDragDelta" />
        </Grid>
        </Grid>
    </Border>
</Window>

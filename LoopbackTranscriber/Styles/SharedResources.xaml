<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:LoopbackTranscriber.Converters"
                    xmlns:services="clr-namespace:LoopbackTranscriber.Services"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <conv:InverseBooleanConverter x:Key="InverseBoolConverter" />
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    <conv:BoolToDimOpacityConverter x:Key="BoolToDimOpacityConverter" />
    <conv:BoolToChatAlignmentConverter x:Key="BoolToChatAlignment" />
    <conv:WidthFractionConverter x:Key="WidthFraction" />

    <DataTemplate x:Key="SummarySectionTemplate">
        <Border CornerRadius="8" Padding="12,10" Margin="0,0,0,10" Background="#14FFFFFF">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                            Visibility="{Binding HasHeading, Converter={StaticResource BoolToVis}}">
                    <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="{Binding LineMargin}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="•" FontSize="13" Opacity="0.6" Margin="2,0,8,0"
                                           Visibility="{Binding IsBullet, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="13" Opacity="0.9"
                                           FontWeight="{Binding TextWeight}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </DataTemplate>

    <Style x:Key="VerticalPanelSplitterStyle" TargetType="GridSplitter">
        <Setter Property="Width" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="{TemplateBinding Background}">
                        <Rectangle x:Name="SplitterLine" Width="2" HorizontalAlignment="Center"
                                   Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SplitterLine" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VirtualizedBubbleListStyle" TargetType="ItemsControl">
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer Focusable="False" CanContentScroll="True"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsPresenter Margin="0,0,14,0" />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChatBubbleBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelf}" Value="True">
                <Setter Property="Background" Value="#2F6FED" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SpinningIconStyle" TargetType="ui:SymbolIcon">
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Viewer.IsViewedSummaryGenerating}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="SpinningIconStoryboard">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                             From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="SpinningIconStoryboard" />
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>

<ui:FluentWindow x:Class="LoopbackTranscriber.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:conv="clr-namespace:LoopbackTranscriber.Converters"
        xmlns:local="clr-namespace:LoopbackTranscriber"
        xmlns:views="clr-namespace:LoopbackTranscriber.Views"
        xmlns:services="clr-namespace:LoopbackTranscriber.Services"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Loopback Transcriber" Height="900" Width="1400" MinHeight="768" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Icon="pack://application:,,,/Assets/AppIcon.ico">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanConverter x:Key="InverseBoolConverter" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:BoolToDimOpacityConverter x:Key="BoolToDimOpacityConverter" />
        <conv:BoolToChatAlignmentConverter x:Key="BoolToChatAlignment" />
        <conv:WidthFractionConverter x:Key="WidthFraction" />

        <Style x:Key="VerticalPanelSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Width" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="{TemplateBinding Background}">
                            <Rectangle x:Name="SplitterLine" Width="2" HorizontalAlignment="Center"
                                       Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SplitterLine" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChatBubbleBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelf}" Value="True">
                    <Setter Property="Background" Value="#2F6FED" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SpinningIconStyle" TargetType="ui:SymbolIcon">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="0" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGeneratingSummary}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="SpinningIconStoryboard">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                 From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="SpinningIconStoryboard" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="RootTitleBar" Grid.Row="0" Title="Loopback Transcriber"
                     Background="Transparent">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/AppIcon.ico" Margin="0,0,-6,0" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid x:Name="ContentBackgroundGrid" Grid.Row="1" Background="Transparent"
              Visibility="{Binding IsFirstRunActive, Converter={StaticResource InverseBoolToVis}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ui:NavigationView x:Name="AppsNavigationView" Grid.Column="0"
                            Background="Transparent"
                            PaneDisplayMode="Left"
                            OpenPaneLength="230"
                            IsPaneOpen="True"
                            IsPaneToggleVisible="True"
                            IsBackButtonVisible="Collapsed"
                            IsFooterSeparatorVisible="True">
            <ui:NavigationView.Resources>
                <SolidColorBrush x:Key="LeftNavigationViewSeparatorBrush" Color="{DynamicResource ControlStrokeColorDefault}" />
            </ui:NavigationView.Resources>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{Binding Path=[NavHistory], Source={x:Static services:Strings.Instance}}"
                                        Command="{Binding ShowHistoryCommand}"
                                        IsActive="{Binding IsHistoryViewActive}"
                                        IsEnabled="{Binding IsRecording, Converter={StaticResource InverseBoolConverter}}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="History24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{Binding Path=[NavApplications], Source={x:Static services:Strings.Instance}}"
                                        Command="{Binding ShowApplicationsCommand}"
                                        IsActive="{Binding IsApplicationsViewActive}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="AppsList24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{Binding Path=[NavConfig], Source={x:Static services:Strings.Instance}}"
                                        Command="{Binding ShowConfigCommand}"
                                        IsActive="{Binding IsConfigViewActive}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <Border Grid.Column="1" Padding="28"
                CornerRadius="16,0,0,0"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <Grid>
                <Grid Visibility="{Binding IsAppViewActive, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{Binding SelectedTarget.DisplayName}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusText}" Opacity="0.75" Margin="0,6,0,0"
                                   TextWrapping="Wrap" />

                        <StackPanel Visibility="{Binding IsTranscribingActive, Converter={StaticResource BoolToVis}}"
                                    Margin="0,10,0,0">
                            <ProgressBar Height="6" Width="260" HorizontalAlignment="Left"
                                         Minimum="0" Maximum="100"
                                         Value="{Binding TranscriptionProgressPercent, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,0" VerticalAlignment="Center">
                        <ui:Button Content="{Binding RecordButtonText}"
                                   Command="{Binding ToggleRecordingCommand}"
                                   ToolTip="{Binding RecordDisabledReason}"
                                   ToolTipService.ShowOnDisabled="True"
                                   Appearance="Primary" FontWeight="SemiBold"
                                   Width="190" Height="36">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Foreground" Value="Black" />
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Foreground" Value="#8C8C8C" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <TextBlock Text="{Binding ElapsedText}" FontSize="16" VerticalAlignment="Center"
                                   Margin="16,0,0,0"
                                   Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,18,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="320" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="420" MinWidth="280" MaxWidth="640" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <ui:Button Padding="6" Appearance="Transparent" Margin="0,0,6,0"
                                           Command="{Binding ClearViewedTranscriptCommand}"
                                           ToolTip="{Binding Path=[ClearTranscriptViewerTooltip], Source={x:Static services:Strings.Instance}}">
                                    <ui:SymbolIcon Symbol="Eraser20" FontSize="14" />
                                </ui:Button>
                                <ui:Button Content="{Binding Path=[TabTranscript], Source={x:Static services:Strings.Instance}}"
                                           Appearance="Transparent" Padding="10,5" Margin="0,0,6,0"
                                           Command="{Binding ShowTranscriptTabCommand}">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="Opacity" Value="0.55" />
                                            <Setter Property="FontWeight" Value="Normal" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsShowingSummaryTab}" Value="False">
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                                <ui:Button Content="{Binding Path=[TabSummary], Source={x:Static services:Strings.Instance}}"
                                           Appearance="Transparent" Padding="10,5"
                                           Command="{Binding ShowSummaryTabCommand}">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="Opacity" Value="0.55" />
                                            <Setter Property="FontWeight" Value="Normal" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsShowingSummaryTab}" Value="True">
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </StackPanel>
                            <ui:Button Grid.Column="1" Appearance="Secondary" Margin="12,0,0,0" Padding="10,5" VerticalAlignment="Center"
                                       Visibility="{Binding ShowViewedSummaryButton, Converter={StaticResource BoolToVis}}"
                                       IsEnabled="{Binding IsViewedSummaryGenerating, Converter={StaticResource InverseBoolConverter}}"
                                       Command="{Binding RegenerateViewedSummaryCommand}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding ShowViewedIdleGenerate, Converter={StaticResource BoolToVis}}">
                                        <ui:SymbolIcon Symbol="Sparkle20" FontSize="14" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Path=[GenerateSummaryButton], Source={x:Static services:Strings.Instance}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsViewedSummaryGenerating, Converter={StaticResource BoolToVis}}">
                                        <ui:SymbolIcon Symbol="ArrowSync20" FontSize="14" Margin="0,0,6,0" Style="{StaticResource SpinningIconStyle}" />
                                        <TextBlock Text="{Binding Path=[GenerateSummaryButtonBusy], Source={x:Static services:Strings.Instance}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding ShowViewedRegenerate, Converter={StaticResource BoolToVis}}">
                                        <ui:SymbolIcon Symbol="CheckmarkCircle20" FontSize="14" Margin="0,0,6,0" Opacity="0.7" />
                                        <TextBlock Text="{Binding Path=[RegenerateSummaryButton], Source={x:Static services:Strings.Instance}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </ui:Button>
                        </Grid>

                        <Grid Grid.Row="0" Grid.Column="2" Margin="6,0,0,8" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Path=[HistoryOfAppTitle], Source={x:Static services:Strings.Instance}}"
                                       FontWeight="SemiBold" Opacity="0.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <ui:Button Grid.Column="1" Margin="0,0,6,0" Padding="12,7" FontSize="13" VerticalAlignment="Center"
                                       Content="{Binding Path=[Delete], Source={x:Static services:Strings.Instance}}"
                                       Command="{Binding DeleteSelectedAppTranscriptsCommand}"
                                       IsEnabled="{Binding CanDeleteSelectedApp}"
                                       ToolTip="{Binding DeleteSelectedAppDisabledReason}"
                                       ToolTipService.ShowOnDisabled="True"
                                       Visibility="{Binding HasSelectedAppHistoryItems, Converter={StaticResource BoolToVis}}" />
                            <ui:Button x:Name="AppHistoryFilterButton" Grid.Column="2" Margin="0,0,6,0" Padding="7" VerticalAlignment="Center"
                                       Command="{Binding ToggleAppHistoryFilterCommand}"
                                       ToolTip="{Binding Path=[FilterTooltip], Source={x:Static services:Strings.Instance}}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasActiveAppHistoryFilter}" Value="True">
                                                <Setter Property="Appearance" Value="Primary" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <ui:SymbolIcon Symbol="Filter16" FontSize="14" />
                            </ui:Button>
                            <ui:Button Grid.Column="3" Padding="7" VerticalAlignment="Center"
                                       Command="{Binding OpenTranscriptsFolderCommand}"
                                       ToolTip="{Binding Path=[OpenFolder], Source={x:Static services:Strings.Instance}}">
                                <ui:SymbolIcon Symbol="FolderOpen20" FontSize="14" />
                            </ui:Button>

                            <Popup Grid.Column="2" PlacementTarget="{Binding ElementName=AppHistoryFilterButton}"
                                   Placement="Left" HorizontalOffset="-6" IsOpen="{Binding IsAppHistoryFilterOpen}"
                                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Width="260" CornerRadius="8" Padding="16"
                                        Background="{DynamicResource FlyoutBackground}"
                                        BorderBrush="{DynamicResource FlyoutBorderBrush}" BorderThickness="1">
                                    <Border.Resources>
                                        <SolidColorBrush x:Key="CalendarViewBackground" Color="#FF2B2B2B" />
                                        <SolidColorBrush x:Key="CalendarViewBorderBrush" Color="#FF3D3D3D" />
                                        <SolidColorBrush x:Key="CalendarViewTodayBackground" Color="#FF6A2BD9" />
                                        <SolidColorBrush x:Key="CalendarViewTodayForeground" Color="#FFFFFFFF" />
                                    </Border.Resources>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Path=[FilterFromDateLabel], Source={x:Static services:Strings.Instance}}"
                                                   FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                                        <DatePicker x:Name="AppHistoryFilterFromDatePicker"
                                                    SelectedDate="{Binding AppHistoryFilterFromDate}" Margin="0,0,0,10"
                                                    DisplayDate="{x:Static sys:DateTime.Today}"
                                                    Background="{DynamicResource FlyoutBackground}"
                                                    BorderBrush="{DynamicResource FlyoutBorderBrush}"
                                                    CalendarOpened="HistoryDatePicker_CalendarOpened" />

                                        <TextBlock Text="{Binding Path=[FilterToDateLabel], Source={x:Static services:Strings.Instance}}"
                                                   FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                                        <DatePicker SelectedDate="{Binding AppHistoryFilterToDate}" Margin="0,0,0,10"
                                                    Background="{DynamicResource FlyoutBackground}"
                                                    BorderBrush="{DynamicResource FlyoutBorderBrush}" />

                                        <TextBlock Text="{Binding Path=[FilterDurationLabel], Source={x:Static services:Strings.Instance}}"
                                                   FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                                        <ui:NumberBox Minimum="0" Margin="0,0,0,12"
                                                      Value="{Binding AppHistoryFilterMinDurationMinutes, UpdateSourceTrigger=PropertyChanged}"
                                                      PlaceholderText="{Binding Path=[FilterMinPlaceholder], Source={x:Static services:Strings.Instance}}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:Button Grid.Column="0" Appearance="Primary" FontWeight="SemiBold"
                                                       Content="{Binding Path=[FilterApplyButton], Source={x:Static services:Strings.Instance}}"
                                                       Command="{Binding ApplyAppHistoryFilterCommand}"
                                                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                            <ui:Button Grid.Column="2"
                                                       Content="{Binding Path=[FilterClearButton], Source={x:Static services:Strings.Instance}}"
                                                       Command="{Binding ClearAppHistoryFilterCommand}"
                                                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                       IsEnabled="{Binding HasActiveAppHistoryFilter}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <Border Grid.Row="1" Grid.Column="0" MinHeight="230" CornerRadius="10" Padding="14"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding IsShowingSummaryTab, Converter={StaticResource InverseBoolToVis}}">
                                    <ItemsControl ItemsSource="{Binding TranscriptMessages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,4"
                                                            MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource WidthFraction}, ConverterParameter=0.55}"
                                                            HorizontalAlignment="{Binding IsSelf, Converter={StaticResource BoolToChatAlignment}}">
                                                    <TextBlock Text="{Binding DisplaySpeaker}" FontSize="13" FontWeight="SemiBold"
                                                               Opacity="0.5" Margin="4,0,4,6" />
                                                    <Border CornerRadius="14" Padding="12,8"
                                                            Style="{StaticResource ChatBubbleBorderStyle}">
                                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" Foreground="White" />
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding IsShowingSummaryTab, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ViewedSummaryTitle}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ViewedSummaryText}" Opacity="0.85" FontSize="13" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Row="1" Grid.Column="1" Style="{StaticResource VerticalPanelSplitterStyle}" />

                        <Border Grid.Row="1" Grid.Column="2" CornerRadius="8"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <Grid Margin="14">
                                <ScrollViewer Margin="0,0,0,0" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding AppTranscriptHistory}" HorizontalContentAlignment="Stretch">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="10,8" Margin="0,0,0,6"
                                                    HorizontalAlignment="Stretch"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.ViewHistoryTranscriptCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                  CommandParameter="{Binding}" />
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <CheckBox Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                                                              VerticalAlignment="Center" Margin="0,0,10,0"
                                                              Padding="0" MinWidth="0" MinHeight="0"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                                                    <Grid Grid.Column="1" Grid.Row="0" VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding DisplayTitle}"
                                                                   FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding TimestampText}" Margin="8,0,0,0"
                                                                   Opacity="0.55" FontSize="11" VerticalAlignment="Center" />
                                                    </Grid>

                                                    <TextBlock Grid.Column="1" Grid.Row="1" Margin="0,4,0,0" Text="{Binding Preview}"
                                                               Opacity="0.7" FontSize="12" VerticalAlignment="Center"
                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />

                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Grid Visibility="{Binding IsHistoryViewActive, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{Binding Path=[HistoryTitle], Source={x:Static services:Strings.Instance}}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Path=[HistorySubtitle], Source={x:Static services:Strings.Instance}}"
                                   Opacity="0.75" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,18,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="320" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="420" MinWidth="280" MaxWidth="640" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <ui:Button Padding="6" Appearance="Transparent" Margin="0,0,6,0"
                                           Command="{Binding ClearViewedTranscriptCommand}"
                                           ToolTip="{Binding Path=[ClearTranscriptViewerTooltip], Source={x:Static services:Strings.Instance}}">
                                    <ui:SymbolIcon Symbol="Eraser20" FontSize="14" />
                                </ui:Button>
                                <ui:Button Content="{Binding Path=[TabTranscript], Source={x:Static services:Strings.Instance}}"
                                           Appearance="Transparent" Padding="10,5" Margin="0,0,6,0"
                                           Command="{Binding ShowTranscriptTabCommand}">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="Opacity" Value="0.55" />
                                            <Setter Property="FontWeight" Value="Normal" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsShowingSummaryTab}" Value="False">
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                                <ui:Button Content="{Binding Path=[TabSummary], Source={x:Static services:Strings.Instance}}"
                                           Appearance="Transparent" Padding="10,5"
                                           Command="{Binding ShowSummaryTabCommand}">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="Opacity" Value="0.55" />
                                            <Setter Property="FontWeight" Value="Normal" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsShowingSummaryTab}" Value="True">
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </StackPanel>
                            <ui:Button Grid.Column="1" Appearance="Secondary" Margin="12,0,0,0" Padding="10,5" VerticalAlignment="Center"
                                       Visibility="{Binding ShowViewedSummaryButton, Converter={StaticResource BoolToVis}}"
                                       IsEnabled="{Binding IsViewedSummaryGenerating, Converter={StaticResource InverseBoolConverter}}"
                                       Command="{Binding RegenerateViewedSummaryCommand}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding ShowViewedIdleGenerate, Converter={StaticResource BoolToVis}}">
                                        <ui:SymbolIcon Symbol="Sparkle20" FontSize="14" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Path=[GenerateSummaryButton], Source={x:Static services:Strings.Instance}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsViewedSummaryGenerating, Converter={StaticResource BoolToVis}}">
                                        <ui:SymbolIcon Symbol="ArrowSync20" FontSize="14" Margin="0,0,6,0" Style="{StaticResource SpinningIconStyle}" />
                                        <TextBlock Text="{Binding Path=[GenerateSummaryButtonBusy], Source={x:Static services:Strings.Instance}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding ShowViewedRegenerate, Converter={StaticResource BoolToVis}}">
                                        <ui:SymbolIcon Symbol="CheckmarkCircle20" FontSize="14" Margin="0,0,6,0" Opacity="0.7" />
                                        <TextBlock Text="{Binding Path=[RegenerateSummaryButton], Source={x:Static services:Strings.Instance}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </ui:Button>
                        </Grid>

                        <Grid Grid.Row="0" Grid.Column="2" Margin="6,0,0,8" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Path=[HistoryListTitle], Source={x:Static services:Strings.Instance}}"
                                       FontWeight="SemiBold" Opacity="0.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <ui:Button Grid.Column="1" Margin="0,0,6,0" Padding="12,7" FontSize="13" VerticalAlignment="Center"
                                       Content="{Binding Path=[Delete], Source={x:Static services:Strings.Instance}}"
                                       Command="{Binding DeleteSelectedTranscriptsCommand}"
                                       IsEnabled="{Binding CanDeleteSelected}"
                                       ToolTip="{Binding DeleteSelectedDisabledReason}"
                                       ToolTipService.ShowOnDisabled="True"
                                       Visibility="{Binding HasSelectedHistoryItems, Converter={StaticResource BoolToVis}}" />
                            <ui:Button x:Name="HistoryFilterButton" Grid.Column="2" Margin="0,0,6,0" Padding="7" VerticalAlignment="Center"
                                       Command="{Binding ToggleHistoryFilterCommand}"
                                       ToolTip="{Binding Path=[FilterTooltip], Source={x:Static services:Strings.Instance}}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasActiveHistoryFilter}" Value="True">
                                                <Setter Property="Appearance" Value="Primary" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <ui:SymbolIcon Symbol="Filter16" FontSize="14" />
                            </ui:Button>
                            <ui:Button Grid.Column="3" Padding="7" VerticalAlignment="Center"
                                       Command="{Binding OpenTranscriptsFolderCommand}"
                                       ToolTip="{Binding Path=[OpenFolder], Source={x:Static services:Strings.Instance}}">
                                <ui:SymbolIcon Symbol="FolderOpen20" FontSize="14" />
                            </ui:Button>

                            <Popup Grid.Column="2" PlacementTarget="{Binding ElementName=HistoryFilterButton}"
                                   Placement="Left" HorizontalOffset="-6" IsOpen="{Binding IsHistoryFilterOpen}"
                                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Width="260" CornerRadius="8" Padding="16"
                                        Background="{DynamicResource FlyoutBackground}"
                                        BorderBrush="{DynamicResource FlyoutBorderBrush}" BorderThickness="1">
                                    <Border.Resources>
                                        <SolidColorBrush x:Key="CalendarViewBackground" Color="#FF2B2B2B" />
                                        <SolidColorBrush x:Key="CalendarViewBorderBrush" Color="#FF3D3D3D" />
                                        <SolidColorBrush x:Key="CalendarViewTodayBackground" Color="#FF6A2BD9" />
                                        <SolidColorBrush x:Key="CalendarViewTodayForeground" Color="#FFFFFFFF" />
                                    </Border.Resources>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Path=[FilterFromDateLabel], Source={x:Static services:Strings.Instance}}"
                                                   FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                                        <DatePicker x:Name="HistoryFilterFromDatePicker"
                                                    SelectedDate="{Binding HistoryFilterFromDate}" Margin="0,0,0,10"
                                                    DisplayDate="{x:Static sys:DateTime.Today}"
                                                    Background="{DynamicResource FlyoutBackground}"
                                                    BorderBrush="{DynamicResource FlyoutBorderBrush}"
                                                    CalendarOpened="HistoryDatePicker_CalendarOpened" />

                                        <TextBlock Text="{Binding Path=[FilterToDateLabel], Source={x:Static services:Strings.Instance}}"
                                                   FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                                        <DatePicker SelectedDate="{Binding HistoryFilterToDate}" Margin="0,0,0,10"
                                                    Background="{DynamicResource FlyoutBackground}"
                                                    BorderBrush="{DynamicResource FlyoutBorderBrush}" />

                                        <TextBlock Text="{Binding Path=[FilterDurationLabel], Source={x:Static services:Strings.Instance}}"
                                                   FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                                        <ui:NumberBox Minimum="0" Margin="0,0,0,12"
                                                      Value="{Binding HistoryFilterMinDurationMinutes, UpdateSourceTrigger=PropertyChanged}"
                                                      PlaceholderText="{Binding Path=[FilterMinPlaceholder], Source={x:Static services:Strings.Instance}}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:Button Grid.Column="0" Appearance="Primary" FontWeight="SemiBold"
                                                       Content="{Binding Path=[FilterApplyButton], Source={x:Static services:Strings.Instance}}"
                                                       Command="{Binding ApplyHistoryFilterCommand}"
                                                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                            <ui:Button Grid.Column="2"
                                                       Content="{Binding Path=[FilterClearButton], Source={x:Static services:Strings.Instance}}"
                                                       Command="{Binding ClearHistoryFilterCommand}"
                                                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                       IsEnabled="{Binding HasActiveHistoryFilter}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <Border Grid.Row="1" Grid.Column="0" MinHeight="230" CornerRadius="10" Padding="14"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding IsShowingSummaryTab, Converter={StaticResource InverseBoolToVis}}">
                                    <ItemsControl ItemsSource="{Binding TranscriptMessages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,4"
                                                            MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource WidthFraction}, ConverterParameter=0.55}"
                                                            HorizontalAlignment="{Binding IsSelf, Converter={StaticResource BoolToChatAlignment}}">
                                                    <TextBlock Text="{Binding DisplaySpeaker}" FontSize="13" FontWeight="SemiBold"
                                                               Opacity="0.5" Margin="4,0,4,6" />
                                                    <Border CornerRadius="14" Padding="12,8"
                                                            Style="{StaticResource ChatBubbleBorderStyle}">
                                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" Foreground="White" />
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding IsShowingSummaryTab, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ViewedSummaryTitle}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ViewedSummaryText}" Opacity="0.85" FontSize="13" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Row="1" Grid.Column="1" Style="{StaticResource VerticalPanelSplitterStyle}" />

                        <Border Grid.Row="1" Grid.Column="2" CornerRadius="8"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <Grid Margin="14">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding FilteredTranscriptHistory}" HorizontalContentAlignment="Stretch">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8" Padding="10,8" Margin="0,0,0,6"
                                                        HorizontalAlignment="Stretch"
                                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                        Cursor="Hand">
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.ViewHistoryTranscriptCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                      CommandParameter="{Binding}" />
                                                    </Border.InputBindings>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <CheckBox Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                                                                  VerticalAlignment="Center" Margin="0,0,10,0"
                                                                  Padding="0" MinWidth="0" MinHeight="0"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                                                        <Grid Grid.Column="1" Grid.Row="0" VerticalAlignment="Center">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding DisplayTitle}"
                                                                       FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1" Text="{Binding TimestampText}" Margin="8,0,0,0"
                                                                       Opacity="0.55" FontSize="11" VerticalAlignment="Center" />
                                                        </Grid>

                                                        <TextBlock Grid.Column="1" Grid.Row="1" Margin="0,4,0,0" Text="{Binding Preview}"
                                                                   Opacity="0.7" FontSize="12" VerticalAlignment="Center"
                                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
                <Grid Visibility="{Binding IsApplicationsViewActive, Converter={StaticResource BoolToVis}}">
                    <views:ApplicationsView DataContext="{Binding ApplicationsViewModel}" />
                </Grid>

                <Grid Visibility="{Binding IsConfigViewActive, Converter={StaticResource BoolToVis}}">
                    <views:ConfigView DataContext="{Binding ConfigViewModel}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>

        <Grid Grid.Row="1" Visibility="{Binding IsFirstRunActive, Converter={StaticResource BoolToVis}}">
            <views:FirstRunView DataContext="{Binding FirstRunViewModel}" />
        </Grid>
    </Grid>
</ui:FluentWindow>

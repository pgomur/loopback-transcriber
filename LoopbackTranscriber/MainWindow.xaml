<ui:FluentWindow x:Class="LoopbackTranscriber.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:conv="clr-namespace:LoopbackTranscriber.Converters"
        xmlns:local="clr-namespace:LoopbackTranscriber"
        xmlns:views="clr-namespace:LoopbackTranscriber.Views"
        xmlns:services="clr-namespace:LoopbackTranscriber.Services"
        mc:Ignorable="d"
        Title="LoopbackTranscriber" Height="900" Width="1400" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToStatusBrushConverter x:Key="BoolToStatusBrush" />
        <conv:InverseBooleanConverter x:Key="InverseBoolConverter" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />

        <Style x:Key="SpinningIconStyle" TargetType="ui:SymbolIcon">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="0" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGeneratingSummary}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="SpinningIconStoryboard">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                 From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="SpinningIconStoryboard" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="LoopbackTranscriber"
                     Background="{DynamicResource ApplicationBackgroundBrush}" />

        <Grid Grid.Row="1" Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ui:NavigationView x:Name="AppsNavigationView" Grid.Column="0"
                            Background="{DynamicResource ApplicationBackgroundBrush}"
                            PaneDisplayMode="Left"
                            OpenPaneLength="230"
                            IsPaneOpen="True"
                            IsPaneToggleVisible="True"
                            IsBackButtonVisible="Collapsed"
                            IsFooterSeparatorVisible="True">
            <ui:NavigationView.Resources>
                <SolidColorBrush x:Key="LeftNavigationViewSeparatorBrush" Color="{DynamicResource ControlStrokeColorDefault}" />
            </ui:NavigationView.Resources>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{Binding Path=[NavHistory], Source={x:Static services:Strings.Instance}}"
                                        Command="{Binding ShowHistoryCommand}"
                                        IsActive="{Binding IsHistoryViewActive}"
                                        IsEnabled="{Binding IsRecording, Converter={StaticResource InverseBoolConverter}}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="History24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{Binding Path=[NavApplications], Source={x:Static services:Strings.Instance}}"
                                        Command="{Binding ShowApplicationsCommand}"
                                        IsActive="{Binding IsApplicationsViewActive}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="AppsList24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{Binding Path=[NavConfig], Source={x:Static services:Strings.Instance}}"
                                        Command="{Binding ShowConfigCommand}"
                                        IsActive="{Binding IsConfigViewActive}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <Border Grid.Column="1" Padding="28"
                CornerRadius="16,0,0,0"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <Grid>
                <Grid Visibility="{Binding IsAppViewActive, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{Binding Path=[AppInfoTitle], Source={x:Static services:Strings.Instance}}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusText}" Opacity="0.75" Margin="0,6,0,0"
                                   TextWrapping="Wrap" />

                        <StackPanel Visibility="{Binding IsTranscribingActive, Converter={StaticResource BoolToVis}}"
                                    Margin="0,10,0,0">
                            <ProgressBar Height="6" Width="260" HorizontalAlignment="Left"
                                         Minimum="0" Maximum="100"
                                         Value="{Binding TranscriptionProgressPercent, Mode=OneWay}" />
                            <TextBlock Text="{Binding TranscriptionProgressText}" Opacity="0.7" FontSize="12"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,0" VerticalAlignment="Center">
                        <ui:Button Content="{Binding RecordButtonText}"
                                   Command="{Binding ToggleRecordingCommand}"
                                   Appearance="Primary" Width="190" Height="36" />
                        <TextBlock Text="{Binding ElapsedText}" FontSize="16" VerticalAlignment="Center"
                                   Margin="16,0,0,0"
                                   Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,18,14,0">
                        <TextBlock Text="{Binding Path=[AppSaveSectionTitle], Source={x:Static services:Strings.Instance}}"
                                   FontWeight="SemiBold" Opacity="0.85" Margin="0,0,0,6" />

                        <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" CornerRadius="8" Padding="10,7" Cursor="Hand"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding SelectedTarget.ToggleSaveAudioCommand}" />
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="Headphones20" FontSize="18" Opacity="1"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Path=[AppSaveAudio], Source={x:Static services:Strings.Instance}}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                                    <CheckBox Grid.Column="2" IsChecked="{Binding SelectedTarget.SaveAudio, Mode=TwoWay}"
                                              IsEnabled="{Binding SelectedTarget.CanToggleSaveAudio}" IsHitTestVisible="False"
                                              VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" CornerRadius="8" Padding="10,7" Cursor="Hand"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding SelectedTarget.ToggleSaveTxtCommand}" />
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="Document20" FontSize="18" Opacity="1"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Path=[AppSaveTxt], Source={x:Static services:Strings.Instance}}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                                    <CheckBox Grid.Column="2" IsChecked="{Binding SelectedTarget.SaveTxt, Mode=TwoWay}"
                                              IsEnabled="{Binding SelectedTarget.CanToggleSaveTxt}" IsHitTestVisible="False"
                                              VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="4" CornerRadius="8" Padding="10,7" Cursor="Hand"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding SelectedTarget.ToggleSaveMarkdownCommand}" />
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="CodeText20" FontSize="18" Opacity="1"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Path=[AppSaveMarkdown], Source={x:Static services:Strings.Instance}}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                                    <CheckBox Grid.Column="2" IsChecked="{Binding SelectedTarget.SaveMarkdown, Mode=TwoWay}"
                                              IsEnabled="{Binding SelectedTarget.CanToggleSaveMarkdown}" IsHitTestVisible="False"
                                              VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,18,14,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:Button Content="{Binding Path=[TabTranscript], Source={x:Static services:Strings.Instance}}"
                                       Appearance="Transparent" Padding="10,5" Margin="0,0,6,0"
                                       Command="{Binding ShowTranscriptTabCommand}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Opacity" Value="0.55" />
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsShowingSummaryTab}" Value="False">
                                                <Setter Property="Opacity" Value="1" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                            <ui:Button Content="{Binding Path=[TabSummary], Source={x:Static services:Strings.Instance}}"
                                       Appearance="Transparent" Padding="10,5"
                                       Command="{Binding ShowSummaryTabCommand}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Opacity" Value="0.55" />
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsShowingSummaryTab}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                        </StackPanel>

                        <Border Height="230" CornerRadius="10" Padding="14"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding IsShowingSummaryTab, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBox Text="{Binding TranscriptText, Mode=OneWay}"
                                             IsReadOnly="True" IsUndoEnabled="False" TextWrapping="Wrap" AcceptsReturn="True"
                                             BorderThickness="0" Background="Transparent"
                                             IsReadOnlyCaretVisible="False" VerticalScrollBarVisibility="Disabled" />
                                </ScrollViewer>

                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding IsShowingSummaryTab, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ViewedSummaryTitle}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ViewedSummaryText}" Opacity="0.85" FontSize="13" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="4" Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Path=[HistoryOfAppTitle], Source={x:Static services:Strings.Instance}}" FontWeight="SemiBold"
                                       Opacity="0.85" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,14,0">
                                <ui:Button Content="{Binding Path=[Delete], Source={x:Static services:Strings.Instance}}" Margin="0,0,8,0"
                                           Command="{Binding DeleteSelectedAppTranscriptsCommand}"
                                           Visibility="{Binding HasSelectedAppHistoryItems, Converter={StaticResource BoolToVis}}" />
                                <ui:Button Content="{Binding Path=[OpenFolder], Source={x:Static services:Strings.Instance}}" Command="{Binding OpenTranscriptsFolderCommand}" />
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
                            <ItemsControl ItemsSource="{Binding AppTranscriptHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="10,8" Margin="0,0,0,6"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.ViewHistoryTranscriptCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding}" />
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <CheckBox Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                                                          VerticalAlignment="Center" Margin="0,0,10,0"
                                                          Padding="0" MinWidth="0" MinHeight="0"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                                                <Grid Grid.Column="1" Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding DisplayTitle}"
                                                               FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Document20" FontSize="13" Opacity="0.55" Margin="0,0,6,0"
                                                                       ToolTip="{Binding Path=[HistoryIconTxtTooltip], Source={x:Static services:Strings.Instance}}"
                                                                       Visibility="{Binding HasTxt, Converter={StaticResource BoolToVis}}" />
                                                        <ui:SymbolIcon Symbol="CodeText20" FontSize="13" Opacity="0.55" Margin="0,0,6,0"
                                                                       ToolTip="{Binding Path=[HistoryIconMdTooltip], Source={x:Static services:Strings.Instance}}"
                                                                       Visibility="{Binding HasMarkdown, Converter={StaticResource BoolToVis}}" />
                                                        <ui:SymbolIcon Symbol="Headphones20" FontSize="13" Opacity="0.55" Margin="0,0,14,0"
                                                                       ToolTip="{Binding Path=[HistoryIconAudioTooltip], Source={x:Static services:Strings.Instance}}"
                                                                       Visibility="{Binding HasAudio, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="{Binding TimestampText}"
                                                                   Opacity="0.55" FontSize="12" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Grid.Column="1" Grid.Row="1" Margin="0,4,0,0" Text="{Binding Preview}"
                                                           Opacity="0.7" FontSize="12" VerticalAlignment="Center"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />

                                                <ui:Button Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Margin="10,0,0,0" Padding="8,4" FontSize="12"
                                                           VerticalAlignment="Center"
                                                           IsEnabled="{Binding IsGeneratingSummary, Converter={StaticResource InverseBoolConverter}}"
                                                           Command="{Binding DataContext.GenerateSummaryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}">
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal" Visibility="{Binding ShowIdleGenerate, Converter={StaticResource BoolToVis}}">
                                                            <ui:SymbolIcon Symbol="Sparkle20" FontSize="13" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding Path=[GenerateSummaryButton], Source={x:Static services:Strings.Instance}}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsGeneratingSummary, Converter={StaticResource BoolToVis}}">
                                                            <ui:SymbolIcon Symbol="ArrowSync20" FontSize="13" Margin="0,0,6,0" Style="{StaticResource SpinningIconStyle}" />
                                                            <TextBlock Text="{Binding Path=[GenerateSummaryButtonBusy], Source={x:Static services:Strings.Instance}}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Visibility="{Binding ShowRegenerate, Converter={StaticResource BoolToVis}}">
                                                            <ui:SymbolIcon Symbol="CheckmarkCircle20" FontSize="13" Margin="0,0,6,0" Opacity="0.7" />
                                                            <TextBlock Text="{Binding Path=[RegenerateSummaryButton], Source={x:Static services:Strings.Instance}}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Grid>
                                                </ui:Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <Grid Visibility="{Binding IsHistoryViewActive, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{Binding Path=[HistoryTitle], Source={x:Static services:Strings.Instance}}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Path=[HistorySubtitle], Source={x:Static services:Strings.Instance}}"
                                   Opacity="0.75" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,16,14,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:Button Content="{Binding Path=[TabTranscript], Source={x:Static services:Strings.Instance}}"
                                       Appearance="Transparent" Padding="10,5" Margin="0,0,6,0"
                                       Command="{Binding ShowTranscriptTabCommand}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Opacity" Value="0.55" />
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsShowingSummaryTab}" Value="False">
                                                <Setter Property="Opacity" Value="1" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                            <ui:Button Content="{Binding Path=[TabSummary], Source={x:Static services:Strings.Instance}}"
                                       Appearance="Transparent" Padding="10,5"
                                       Command="{Binding ShowSummaryTabCommand}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Opacity" Value="0.55" />
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsShowingSummaryTab}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                        </StackPanel>

                        <Border Height="260" CornerRadius="10" Padding="14"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding IsShowingSummaryTab, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBox Text="{Binding TranscriptText, Mode=OneWay}"
                                             IsReadOnly="True" IsUndoEnabled="False" TextWrapping="Wrap" AcceptsReturn="True"
                                             BorderThickness="0" Background="Transparent"
                                             IsReadOnlyCaretVisible="False" VerticalScrollBarVisibility="Disabled" />
                                </ScrollViewer>

                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding IsShowingSummaryTab, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ViewedSummaryTitle}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ViewedSummaryText}" Opacity="0.85" FontSize="13" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Path=[HistoryListTitle], Source={x:Static services:Strings.Instance}}" FontWeight="SemiBold"
                                   Opacity="0.85" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,14,0">
                            <ui:Button Content="{Binding Path=[Delete], Source={x:Static services:Strings.Instance}}" Margin="0,0,8,0"
                                       Command="{Binding DeleteSelectedTranscriptsCommand}"
                                       Visibility="{Binding HasSelectedHistoryItems, Converter={StaticResource BoolToVis}}" />
                            <ui:Button Content="{Binding Path=[OpenFolder], Source={x:Static services:Strings.Instance}}" Command="{Binding OpenTranscriptsFolderCommand}" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="3" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
                        <ItemsControl ItemsSource="{Binding TranscriptHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="10,8" Margin="0,0,0,6"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                            Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.ViewHistoryTranscriptCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <CheckBox Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                                                      VerticalAlignment="Center" Margin="0,0,10,0"
                                                      Padding="0" MinWidth="0" MinHeight="0"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                                            <Grid Grid.Column="1" Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DisplayTitle}"
                                                           FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Document20" FontSize="13" Opacity="0.55" Margin="0,0,6,0"
                                                                   ToolTip="{Binding Path=[HistoryIconTxtTooltip], Source={x:Static services:Strings.Instance}}"
                                                                   Visibility="{Binding HasTxt, Converter={StaticResource BoolToVis}}" />
                                                    <ui:SymbolIcon Symbol="CodeText20" FontSize="13" Opacity="0.55" Margin="0,0,6,0"
                                                                   ToolTip="{Binding Path=[HistoryIconMdTooltip], Source={x:Static services:Strings.Instance}}"
                                                                   Visibility="{Binding HasMarkdown, Converter={StaticResource BoolToVis}}" />
                                                    <ui:SymbolIcon Symbol="Headphones20" FontSize="13" Opacity="0.55" Margin="0,0,14,0"
                                                                   ToolTip="{Binding Path=[HistoryIconAudioTooltip], Source={x:Static services:Strings.Instance}}"
                                                                   Visibility="{Binding HasAudio, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{Binding TimestampText}"
                                                               Opacity="0.55" FontSize="12" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Grid.Column="1" Grid.Row="1" Margin="0,4,0,0" Text="{Binding Preview}"
                                                       Opacity="0.7" FontSize="12" VerticalAlignment="Center"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />

                                            <ui:Button Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Margin="10,0,0,0" Padding="8,4" FontSize="12"
                                                       VerticalAlignment="Center"
                                                       IsEnabled="{Binding IsGeneratingSummary, Converter={StaticResource InverseBoolConverter}}"
                                                       Command="{Binding DataContext.GenerateSummaryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}">
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" Visibility="{Binding ShowIdleGenerate, Converter={StaticResource BoolToVis}}">
                                                        <ui:SymbolIcon Symbol="Sparkle20" FontSize="13" Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding Path=[GenerateSummaryButton], Source={x:Static services:Strings.Instance}}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsGeneratingSummary, Converter={StaticResource BoolToVis}}">
                                                        <ui:SymbolIcon Symbol="ArrowSync20" FontSize="13" Margin="0,0,6,0" Style="{StaticResource SpinningIconStyle}" />
                                                        <TextBlock Text="{Binding Path=[GenerateSummaryButtonBusy], Source={x:Static services:Strings.Instance}}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Visibility="{Binding ShowRegenerate, Converter={StaticResource BoolToVis}}">
                                                        <ui:SymbolIcon Symbol="CheckmarkCircle20" FontSize="13" Margin="0,0,6,0" Opacity="0.7" />
                                                        <TextBlock Text="{Binding Path=[RegenerateSummaryButton], Source={x:Static services:Strings.Instance}}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </ui:Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <Grid Visibility="{Binding IsApplicationsViewActive, Converter={StaticResource BoolToVis}}">
                    <views:ApplicationsView DataContext="{Binding ApplicationsViewModel}" />
                </Grid>

                <Grid Visibility="{Binding IsConfigViewActive, Converter={StaticResource BoolToVis}}">
                    <views:ConfigView DataContext="{Binding ConfigViewModel}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
    </Grid>
</ui:FluentWindow>

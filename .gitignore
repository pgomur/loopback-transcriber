## .gitignore para proyecto .NET / Visual Studio (LoopbackTranscriber)

# Carpetas de compilación
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ll]og/
[Ll]ogs/

# Carpeta de Visual Studio
.vs/

# Archivos de usuario (configuración local, no se comparten)
*.user
*.suo
*.userosscache
*.sln.docstates

# Archivos de compilación de MSBuild
*.pdb
*.ilk
*.meta
*.obj
*.iobj
*.pch
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.log
*.tlog
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# Paquetes NuGet
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets

# Resultados de pruebas
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml

# Archivos de ReSharper / Rider
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
.idea/

# Archivos de sistema
[Dd]esktop.ini
Thumbs.db
.DS_Store

# Publicación / despliegue
[Pp]ublish/
*.publishsettings
PublishProfiles/
*.azurePubxml

# Otros
*.cache
*.env

# Instalador (Inno Setup): el .iss se versiona, pero el Setup.exe compilado no
installer/Output/

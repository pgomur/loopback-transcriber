## .gitignore for the LoopbackTranscriber .NET / Visual Studio project

# Build folders
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ll]og/
[Ll]ogs/

# Visual Studio folder
.vs/

# User files (local settings, not shared)
*.user
*.suo
*.userosscache
*.sln.docstates

# MSBuild output files
*.pdb
*.ilk
*.meta
*.obj
*.iobj
*.pch
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.log
*.tlog
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# NuGet packages
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml

# ReSharper / Rider files
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
.idea/

# System files
[Dd]esktop.ini
Thumbs.db
.DS_Store

# Publishing / deployment
[Pp]ublish/
*.publishsettings
**/PublishProfiles/*

# The publish profile used by the installer is versioned
!**/Properties/PublishProfiles/FolderProfile.pubxml
*.azurePubxml

# Other
*.cache
*.env

installer/Output/
installer/redist/
